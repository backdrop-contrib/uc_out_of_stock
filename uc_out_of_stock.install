<?php
/**
 * @file
 * (Un)Installation procedures.
 */

/**
 * Implements hook_update_last_removed().
 */
function uc_out_of_stock_update_last_removed() {
  return 7000;
}

/**
 * Moves the module variables to config.
 */
function uc_out_of_stock_update_1000() {
  $config = config('uc_out_of_stock.settings');
  $config->set('uc_out_of_stock_text', update_variable_get('uc_out_of_stock_text', array(
    'value' => '<span class="uc-out-of-stock-message">Out of stock</span>',
    'format' => 'filtered_html',
  )));
  $config->set('uc_out_of_stock_disable_js', (bool) update_variable_get('uc_out_of_stock_disable_js', FALSE));
  $config->set('uc_out_of_stock_instock', (bool) update_variable_get('uc_out_of_stock_instock', TRUE));
  $config->set('uc_out_of_stock_throbber', (bool) update_variable_get('uc_out_of_stock_throbber', TRUE));
  $config->save();

  update_variable_del('uc_out_of_stock_text');
  update_variable_del('uc_out_of_stock_disable_js');
  update_variable_del('uc_out_of_stock_instock');
  update_variable_del('uc_out_of_stock_throbber');
}

/**
 * Adds the in-stock display threshold setting.
 */
function uc_out_of_stock_update_1001() {
  $config = config('uc_out_of_stock.settings');
  if ($config->get('uc_out_of_stock_instock_threshold') === NULL) {
    $config->set('uc_out_of_stock_instock_threshold', 0);
    $config->save();
  }
}
