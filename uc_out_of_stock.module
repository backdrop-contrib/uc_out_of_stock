<?php
/**
 * @file
 * The Out of stock notification module file.
 *
 * It provides both client side and server side stock validation.
 */

/**
 * Implements hook_config_info().
 */
function uc_out_of_stock_config_info() {
  $prefixes['uc_out_of_stock.settings'] = array(
    'label' => t('Out of stock notification settings'),
    'group' => t('Configuration'),
  );
  return $prefixes;
}

/**
 * Implements hook_form_alter().
 */
function uc_out_of_stock_form_alter(&$form, &$form_state, $form_id) {
  static $settings_js = array();

  $forms = array('uc_product_add_to_cart_form', 'uc_catalog_buy_it_now_form');
  foreach ($forms as $id) {
    if (backdrop_substr($form_id, 0, backdrop_strlen($id)) == $id) {

      // Only add JavaScript if it was enabled.
      if (!config_get('uc_out_of_stock.settings', 'uc_out_of_stock_disable_js')) {
        backdrop_add_js(backdrop_get_path('module', 'uc_out_of_stock') . '/uc_out_of_stock.js');
        backdrop_add_css(backdrop_get_path('module', 'uc_out_of_stock') . '/uc_out_of_stock.css');
        if (empty($settings_js)) {
          $text = config_get('uc_out_of_stock.settings', 'uc_out_of_stock_text');
          $settings_js['uc_out_of_stock']['path'] = url('uc_out_of_stock/query');
          $settings_js['uc_out_of_stock']['throbber'] = (bool) config_get('uc_out_of_stock.settings', 'uc_out_of_stock_throbber');
          $settings_js['uc_out_of_stock']['instock'] = (bool) config_get('uc_out_of_stock.settings', 'uc_out_of_stock_instock');
          $settings_js['uc_out_of_stock']['instock_threshold'] = (int) config_get('uc_out_of_stock.settings', 'uc_out_of_stock_instock_threshold');
          $settings_js['uc_out_of_stock']['msg'] = check_markup($text['value'], $text['format']);
          backdrop_add_js($settings_js, 'setting');
        }
      }

      $form['#validate'][] = 'uc_out_of_stock_validate_form_addtocart';
    }
  }

  if ($form_id == 'uc_cart_view_form') {
    $form['#validate'][] = 'uc_out_of_stock_validate_form_cart';
  }

  if ($form_id == 'uc_cart_checkout_form' || $form_id == 'uc_cart_checkout_review_form') {
    $form['#validate'][] = 'uc_out_of_stock_validate_form_checkout';
  }
}

/**
 * Implements hook_menu().
 */
function uc_out_of_stock_menu() {
  $items = array();

  $items['admin/store/settings/uc_out_of_stock'] = array(
    'title' => 'Out of Stock Notification',
    'access arguments' => array('administer store'),
    'description' => 'Configure out of stock settings.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('uc_out_of_stock_settings'),
    'type' => MENU_NORMAL_ITEM,
  );

  $items['uc_out_of_stock/query'] = array(
    'title' => 'stock query',
    'page callback' => 'uc_out_of_stock_query',
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
  );

  return $items;
}

/****************************
 * Helper functions
 ***************************/

/**
 * Normalizes an attribute selection to array(aid => oid), sorted by aid.
 *
 * Empty selections and non-scalar values (e.g. checkbox arrays) are dropped.
 *
 * @param mixed $attrs
 *   Array of attribute id => option id.
 *
 * @return array
 *   Integer attribute ids mapped to option ids as strings.
 */
function _uc_out_of_stock_normalize_attrs($attrs) {
  $normalized = array();
  if (!is_array($attrs)) {
    return $normalized;
  }
  foreach ($attrs as $aid => $oid) {
    if (is_scalar($oid) && (string) $oid !== '') {
      $normalized[(int) $aid] = (string) $oid;
    }
  }
  ksort($normalized);
  return $normalized;
}

/**
 * Helper function to retrieve stock information directly from the stock table
 * querying it by model.
 *
 * @param string $model
 *   The SKU.
 *
 * @return array
 *   Array of the stock information or an empty array if none.
 */
function uc_out_of_stock_getstockinfo_from_model($model) {
  $stockinfo = array();
  $stock = db_query("SELECT ups.stock FROM {uc_product_stock} ups WHERE ups.active = 1 AND ups.sku = :sku", array(':sku' => $model))->fetchField();
  if (is_numeric($stock)) {
    $stockinfo['stock'] = $stock;
    $stockinfo['model'] = $model;
  }

  return $stockinfo;
}

/**
 * Helper function to retrieve stock information looked up by nid and
 * attributes.
 *
 * Rules:
 * - If the product has SKU adjustments and not all attributes that take part
 *   in an adjustment are selected yet, the stock is unknown (empty result).
 * - Otherwise the adjustment whose combination matches the selection is used.
 *   Attributes that are not part of the combination (e.g. a select attribute
 *   without SKU adjustment) are ignored. If several combinations match, the
 *   most specific one wins.
 * - If an adjustment matches, only its own SKU is checked. If this SKU has no
 *   active stock record, stock is not tracked for it (empty result); the main
 *   SKU is NOT used as a fallback because the cart uses the adjusted SKU.
 * - If no adjustment matches, the cart uses the main SKU, so it is checked.
 *
 * @param int $nid
 *   Node id.
 * @param array $attrs
 *   Selected attributes (aid => oid).
 *
 * @return array
 *   Array with 'stock' and 'model', or an empty array if unknown/untracked.
 */
function uc_out_of_stock_getstockinfo($nid, $attrs) {
  $stockinfo = array();
  $nid = (int) $nid;
  $attrs = _uc_out_of_stock_normalize_attrs($attrs);
  $query_main_sku = TRUE;

  if (module_exists('uc_attribute')) {
    $result = db_query('SELECT upa.combination, upa.model, ups.sku, ups.active, ups.stock FROM {uc_product_adjustments} upa LEFT JOIN {uc_product_stock} ups ON ups.sku = upa.model WHERE upa.nid = :nid', array(':nid' => $nid));

    $rows = array();
    $adjusted_aids = array();
    foreach ($result as $row) {
      $combination = unserialize($row->combination);
      if (!is_array($combination) || !count($combination)) {
        continue;
      }
      $row->combination = _uc_out_of_stock_normalize_attrs($combination);
      $rows[] = $row;
      foreach (array_keys($row->combination) as $aid) {
        $adjusted_aids[$aid] = $aid;
      }
    }

    if ($rows) {
      // Not all adjusted attributes selected yet: the SKU is not determined.
      // (Also covers catalog list views, where no attributes are sent.)
      foreach ($adjusted_aids as $aid) {
        if (!isset($attrs[$aid])) {
          return array();
        }
      }

      $best = NULL;
      $best_size = -1;
      foreach ($rows as $row) {
        $match = TRUE;
        foreach ($row->combination as $aid => $oid) {
          if (!isset($attrs[$aid]) || $attrs[$aid] !== $oid) {
            $match = FALSE;
            break;
          }
        }
        if ($match && count($row->combination) > $best_size) {
          $best = $row;
          $best_size = count($row->combination);
        }
      }

      if ($best) {
        $query_main_sku = FALSE;
        if (isset($best->sku) && $best->active && is_numeric($best->stock)) {
          $stockinfo['stock'] = $best->stock;
          $stockinfo['model'] = $best->model;
        }
      }
    }
  }

  if ($query_main_sku) {
    $result = db_query("SELECT ups.stock, up.model FROM {uc_products} up LEFT JOIN {uc_product_stock} ups ON ups.sku = up.model WHERE up.nid = :nid AND ups.active = 1", array(':nid' => $nid));
    foreach ($result as $row) {
      $stockinfo['stock'] = $row->stock;
      $stockinfo['model'] = $row->model;
    }
  }

  return $stockinfo;
}

/**
 * Menu callback: returns the stock level for each requested form as JSON.
 */
function uc_out_of_stock_query() {
  $form_ids = (isset($_POST['form_ids']) && is_array($_POST['form_ids'])) ? array_values($_POST['form_ids']) : array();
  $node_ids = (isset($_POST['node_ids']) && is_array($_POST['node_ids'])) ? array_values($_POST['node_ids']) : array();

  if (!count($form_ids) || count($form_ids) != count($node_ids)) {
    backdrop_add_http_header('Status', '400 Bad Request');
    print 'Missing or inconsistent form_ids and node_ids.';
    backdrop_exit();
  }

  $attribs = array();
  if (isset($_POST['attr_ids']) && is_array($_POST['attr_ids'])) {
    foreach ($_POST['attr_ids'] as $value) {
      $parts = explode(':', (string) $value);
      if (count($parts) == 3) {
        $attribs[(int) $parts[0]][(int) $parts[1]] = $parts[2];
      }
    }
  }

  // Always resolve the SKU per node (with its attributes) so products with
  // SKU adjustments never fall back to the stock of the main SKU.
  $return = array();
  foreach ($form_ids as $key => $form_id) {
    $form_id = (string) $form_id;
    $nid = (int) $node_ids[$key];
    $return[$form_id] = NULL;
    $stockinfo = uc_out_of_stock_getstockinfo($nid, isset($attribs[$nid]) ? $attribs[$nid] : array());
    if ($stockinfo) {
      $return[$form_id] = (int) $stockinfo['stock'];
    }
  }

  backdrop_json_output($return);
  backdrop_exit();
}

/**
 * Settings form.
 */
function uc_out_of_stock_settings($form, &$form_state) {
  $form['#config'] = 'uc_out_of_stock.settings';
  $config = config('uc_out_of_stock.settings');

  $form['uc_out_of_stock_throbber'] = array(
    '#type' => 'checkbox',
    '#title' => t('Display throbber'),
    '#default_value' => $config->get('uc_out_of_stock_throbber'),
    '#description' => t('Display a throbber (animated wheel) next to add to cart button. This can be themed/styled and removed via CSS as well, but you can just disable it with this setting.'),
  );

  $form['uc_out_of_stock_instock'] = array(
    '#type' => 'checkbox',
    '#title' => t('Display in stock information'),
    '#default_value' => $config->get('uc_out_of_stock_instock'),
    '#description' => t('Display how many items are in stock above the add to cart button or below the qty field if it is present. If the product has attributes with SKU adjustments, the stock is only known after all of these attributes are selected; until then (or if stock is not tracked for the SKU) a generic "In stock" message is shown.'),
  );

  $form['uc_out_of_stock_instock_threshold'] = array(
    '#type' => 'number',
    '#title' => t('Show exact quantity only up to'),
    '#default_value' => (int) $config->get('uc_out_of_stock_instock_threshold'),
    '#min' => 0,
    '#description' => t('If set to a value greater than 0, the exact quantity is shown only when the remaining stock is at or below this value; otherwise a generic "In stock" message is shown. 0 always shows the exact quantity.'),
    '#states' => array(
      'visible' => array(
        ':input[name="uc_out_of_stock_instock"]' => array('checked' => TRUE),
      ),
    ),
  );

  $text = $config->get('uc_out_of_stock_text');
  $rendered = check_markup($text['value'], $text['format']);
  $description = t('<div class="description">This is the value below rendered as you would expect to see it</div>');
  $rendered = '<div style="border: 1px solid lightgrey; padding: 10px;">' . $rendered . '</div>' . $description;

  $form['uc_out_of_stock_demo'] = array(
    '#markup' => $rendered,
  );
  $form['uc_out_of_stock_text'] = array(
    '#type' => 'text_format',
    '#title' => t('Out of stock replacement HTML'),
    '#default_value' => $text['value'],
    '#format' => $text['format'],
    '#description' => t('The HTML that will replace the Add To Cart button if no stock is available.'),
  );

  $form['advanced'] = array(
    '#type' => 'fieldset',
    '#title' => t('Advanced settings'),
    '#collapsible' => TRUE,
    '#collapsed' => !$config->get('uc_out_of_stock_disable_js'),
  );
  $form['advanced']['uc_out_of_stock_disable_js'] = array(
    '#type' => 'checkbox',
    '#title' => t('Disable JavaScript'),
    '#default_value' => $config->get('uc_out_of_stock_disable_js'),
    '#description' => t('If you disable JavaScript you will lose real-time checking of stock, support for checking for stock on attribute change and all of the HTML replacement configured above. Use it with caution. This can be useful if you think this module is in conflict with some other third-party Ubercart module and you want to keep the server side validation of this module.'),
  );

  return system_settings_form($form);
}

/**
 * Shared logic for add to cart validation.
 *
 * @param int $nid
 *   Node id.
 * @param array $attrs
 *   Selected attributes (aid => oid).
 * @param int $qty_add
 *   Quantity being added.
 *
 * @return mixed
 *   FALSE if no error, error array (with 'msg') otherwise.
 */
function uc_out_of_stock_validate_addtocart($nid, $attrs, $qty_add) {
  $error = FALSE;
  $attrs = _uc_out_of_stock_normalize_attrs($attrs);
  $stockinfo = uc_out_of_stock_getstockinfo($nid, $attrs);
  if ($stockinfo) {
    if ($stockinfo['stock'] <= 0) {
      $error = _uc_out_of_stock_get_error('out_of_stock', $nid, $attrs, $stockinfo['stock']);
    }
    else {
      $qty = 0;
      $items = uc_cart_get_contents();
      foreach ($items as $item) {
        if ($item->nid == $nid && $stockinfo['model'] == $item->model) {
          $qty += $item->qty;
        }
      }

      if ($stockinfo['stock'] - ($qty + $qty_add) < 0) {
        $error = _uc_out_of_stock_get_error('not_enough', $nid, $attrs, $stockinfo['stock'], $qty);
      }
    }
  }

  return $error;
}

/**
 * Validate the 'Add To Cart' form of each product preventing the addition of
 * out of stock items or more items than currently in stock.
 *
 * Supports teaser view, full node view and catalog view.
 */
function uc_out_of_stock_validate_form_addtocart($form, &$form_state) {
  // If there were previous form errors, such as missing attributes, skip
  // validation as the information might not be complete.
  if (form_get_errors()) {
    return;
  }

  if (isset($form_state['clicked_button']['#attributes']['class'])) {
    $class = $form_state['clicked_button']['#attributes']['class'];

    // Uses the class of the add to cart button of both node view and catalog
    // view to decide if we should validate stock or not.
    if (in_array('node-add-to-cart', $class) || in_array('list-add-to-cart', $class)) {
      $attrs = isset($form_state['values']['attributes']) ? $form_state['values']['attributes'] : array();

      foreach ((array) $attrs as $aid => $oids) {
        $attribute = uc_attribute_load($aid);
        // 1 is select and 2 is radio, the only supported attributes that may
        // have stock adjustments.
        if (!$attribute || ($attribute->display != 1 && $attribute->display != 2)) {
          unset($attrs[$aid]);
        }
      }
      $nid = $form_state['values']['nid'];
      $qty = isset($form_state['values']['qty']) ? $form_state['values']['qty'] : 1;

      $error = uc_out_of_stock_validate_addtocart($nid, $attrs, $qty);
      if ($error !== FALSE) {
        form_set_error('uc_out_of_stock', $error['msg']);
      }
    }
  }
}

/**
 * Validates items in the cart referenced in a form.
 *
 * @param array $items
 *   Cart items.
 * @param string $page
 *   'cart' or 'checkout'.
 */
function uc_out_of_stock_validate_cart_items($items, $page = 'cart') {
  if (!is_array($items)) {
    return;
  }

  $cart_items = array();
  $stored_cart_items = uc_cart_get_contents();

  // First group by model.
  foreach ($items as $k => $item) {
    // Convert it to object just in case is an array (if coming from a form
    // POST).
    $item = (object) $item;

    // Only process node products, to prevent discounts or other kind of things
    // in the node to mess with this logic.
    if (empty($item->nid)) {
      continue;
    }

    // Unserialize data if string.
    if (isset($item->data) && is_string($item->data)) {
      $item->data = unserialize($item->data);
    }
    // If the item comes from the submitted cart, it doesn't have the model
    // set, so we try to get it from the stored cart items.
    if (!isset($item->model)) {
      $stored_item = NULL;
      if (isset($item->cart_item_id) && isset($stored_cart_items[$item->cart_item_id])) {
        $stored_item = $stored_cart_items[$item->cart_item_id];
      }
      if ($stored_item && $item->nid == $stored_item->nid && $item->data == $stored_item->data) {
        $item->model = $stored_item->model;
      }
      else {
        foreach ($stored_cart_items as $candidate) {
          if ($item->nid == $candidate->nid && $item->data == $candidate->data) {
            $item->model = $candidate->model;
          }
        }
      }
    }

    if (isset($item->model)) {
      $cart_items[$item->model]['item'] = $item;
      if (!isset($cart_items[$item->model]['qty'])) {
        $cart_items[$item->model]['qty'] = 0;
      }
      $cart_items[$item->model]['qty'] += $item->qty;
      $cart_items[$item->model]['key'] = $k;
    }
  }

  // Now for each model, check the stock.
  foreach ($cart_items as $model => $cart_item) {
    $item = $cart_item['item'];
    // Only validate if there are items in the cart, otherwise it's likely
    // it's being removed by setting the qty to 0.
    if ($cart_item['qty'] > 0) {
      $stockinfo = uc_out_of_stock_getstockinfo_from_model($model);
      if ($stockinfo) {
        if ($stockinfo['stock'] - $cart_item['qty'] < 0) {
          $qty = 0;
          if ($page == 'checkout') {
            $qty = $cart_item['qty'];
          }
          $attrs = (is_array($item->data) && isset($item->data['attributes'])) ? $item->data['attributes'] : array();
          if ($stockinfo['stock'] <= 0) {
            $error = _uc_out_of_stock_get_error('out_of_stock', $item->nid, $attrs, $stockinfo['stock']);
          }
          else {
            $error = _uc_out_of_stock_get_error('not_enough', $item->nid, $attrs, $stockinfo['stock'], $qty);
          }
          form_set_error("items][{$cart_item['key']}][qty", $error['msg']);
        }
      }
    }
  }
}

/**
 * Validate the 'Order Checkout' and 'Order Review' form preventing the order
 * going through if the stock information changed while the user was browsing.
 */
function uc_out_of_stock_validate_form_checkout($form, &$form_state) {
  $items = uc_cart_get_contents();
  uc_out_of_stock_validate_cart_items($items, 'checkout');
}

/**
 * Validate the 'Shopping cart' form preventing more items than in stock.
 */
function uc_out_of_stock_validate_form_cart($form, &$form_state) {
  $items = $form_state['values']['items'];
  $name = isset($form_state['clicked_button']['#name']) ? $form_state['clicked_button']['#name'] : '';
  $id = isset($form_state['clicked_button']['#id']) ? $form_state['clicked_button']['#id'] : '';
  if (substr($name, 0, 7) != 'remove-' && $id != 'edit-empty') {
    uc_out_of_stock_validate_cart_items($items, 'cart');
  }
}

/**
 * Helper function to format the form error messages across the validators.
 *
 * @param string $type
 *   'out_of_stock' or 'not_enough'.
 * @param int $nid
 *   Node id.
 * @param array $attrs
 *   Attributes array (aid => oid).
 * @param int $stock
 *   Stock of the current item.
 * @param int $qty
 *   Quantity already in the cart.
 *
 * @return array
 *   Error array including the 'msg' key.
 */
function _uc_out_of_stock_get_error($type, $nid, $attrs, $stock, $qty = 0) {
  $product = node_load($nid);
  $attr_names = array();
  $option_names = array();

  foreach ((array) $attrs as $attr_id => $option_id) {
    if (!is_scalar($option_id) || (string) $option_id === '') {
      continue;
    }
    $attr = uc_attribute_load($attr_id);
    $option = uc_attribute_option_load($option_id);
    if ($attr && $option) {
      $attr_names[] = $attr->name;
      $option_names[] = $option->name;
    }
  }

  $error = array();
  $error['stock'] = $stock;
  $error['qty_in_cart'] = $qty;
  $error['type'] = $type;
  $error['product'] = $product ? $product->title : '';
  if (count($attr_names)) {
    $error['attributes'] = implode('/', $attr_names);
    $error['options'] = implode('/', $option_names);
  }

  if ($type == 'out_of_stock') {
    if (count($attr_names)) {
      $error['msg'] = t("We're sorry. The product @product (@options) is out of stock. Please consider trying this product with a different @attributes.", array('@product' => $error['product'], '@attributes' => $error['attributes'], '@options' => $error['options']));
    }
    else {
      $error['msg'] = t("We're sorry. The product @product is out of stock.", array('@product' => $error['product']));
    }
  }

  if ($type == 'not_enough') {
    if (count($attr_names)) {
      $error['msg'] = t("We're sorry. We have now only @qty of the product @product (@options) left in stock.", array('@qty' => format_plural($error['stock'], '1 unit', '@count units'), '@product' => $error['product'], '@options' => $error['options']));
    }
    else {
      $error['msg'] = t("We're sorry. We have now only @qty of the product @product left in stock.", array('@qty' => format_plural($error['stock'], '1 unit', '@count units'), '@product' => $error['product']));
    }
    if ($error['qty_in_cart']) {
      $error['msg'] .= ' ' . t("You have currently @qty in your <a href=\"@cart-url\">shopping cart</a>.", array('@qty' => format_plural($error['qty_in_cart'], '1 unit', '@count units'), '@cart-url' => url('cart')));
    }
  }

  // Allow all modules to alter the resulting error message.
  backdrop_alter('uc_out_of_stock_error', $error, $product);

  return $error;
}
